@inherits LayoutComponentBase

@*
    Mise en page des pages publiques du compte (connexion, mot de passe oublié,
    réinitialisation). Ces pages sont rendues côté serveur, sans circuit : uniquement du
    HTML et des formulaires, pas de composant MudBlazor interactif.
*@

<div class="min-h-screen flex items-center justify-center p-4"
     style="background: linear-gradient(135deg, var(--app-secondaire) 0%, var(--app-tertiaire) 100%);">

    <div class="w-full max-w-md">
        <div class="flex justify-center mb-8">
            <AppMarque FondSombre="true" Grande="true" />
        </div>

        <main class="bg-white rounded-2xl shadow-2xl p-8">
            @Body
        </main>
    </div>
</div>
