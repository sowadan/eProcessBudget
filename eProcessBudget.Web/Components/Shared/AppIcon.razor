@*
    Icônes SVG (jeu Heroicons, style « outline »).

    Pourquoi ce composant plutôt que MudIcon : ces icônes servent dans la barre latérale
    et les boutons Tailwind, où l'on veut un SVG qui hérite de currentColor et se
    dimensionne par des classes utilitaires. MudIcon reste utilisé à l'intérieur des
    composants MudBlazor.

    POUR AJOUTER UNE ICÔNE :
      1. copiez le contenu <path> depuis heroicons.com (style Outline, 24x24) ;
      2. ajoutez un case dans le switch ci-dessous ;
      3. utilisez-la : <AppIcon Nom="mon-icone" />
*@

@switch (Nom)
{
    case "office-building":
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="@Css">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="@Epaisseur"
                  d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
        </svg>
        break;

    case "key":
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="@Css">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="@Epaisseur"
                  d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
        </svg>
        break;

    case "logout":
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="@Css">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="@Epaisseur"
                  d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
        </svg>
        break;

    case "clock":
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="@Css">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="@Epaisseur"
                  d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        break;

    case "lock-open":
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="@Css">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="@Epaisseur"
                  d="M8 11V7a4 4 0 118 0m-4 8v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2z" />
        </svg>
        break;

    case "home":
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="@Css">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="@Epaisseur"
                  d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
        </svg>
        break;

    case "collection":
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="@Css">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="@Epaisseur"
                  d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
        </svg>
        break;

    case "document-text":
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="@Css">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="@Epaisseur"
                  d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        break;

    case "sparkles":
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="@Css">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="@Epaisseur"
                  d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
        </svg>
        break;

    case "users":
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="@Css">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="@Epaisseur"
                  d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
        </svg>
        break;

    case "shield-check":
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="@Css">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="@Epaisseur"
                  d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
        </svg>
        break;

    case "bell":
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="@Css">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="@Epaisseur"
                  d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6 6 0 10-12 0v3.159c0 .538-.214 1.055-.595 1.437L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
        </svg>
        break;

    case "search":
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="@Css">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="@Epaisseur"
                  d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        break;

    case "chart-bar":
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="@Css">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="@Epaisseur"
                  d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
        </svg>
        break;

    case "plus":
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="@Css">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="@Epaisseur" d="M12 4v16m8-8H4" />
        </svg>
        break;

    case "pencil":
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="@Css">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="@Epaisseur"
                  d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
        </svg>
        break;

    case "trash":
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="@Css">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="@Epaisseur"
                  d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
        </svg>
        break;

    case "adjustments":
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="@Css">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="@Epaisseur"
                  d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
        </svg>
        break;

    case "arrow-right":
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="@Css">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="@Epaisseur"
                  d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
        break;

    case "x-circle":
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="@Css">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="@Epaisseur"
                  d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        break;

    case "lock-closed":
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="@Css">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="@Epaisseur"
                  d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
        </svg>
        break;

    case "cash":
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="@Css">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="@Epaisseur"
                  d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z" />
        </svg>
        break;

    case "scale":
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="@Css">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="@Epaisseur"
                  d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3" />
        </svg>
        break;

    case "check-circle":
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="@Css">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="@Epaisseur"
                  d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        break;

    case "exclamation":
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="@Css">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="@Epaisseur"
                  d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
        break;

    case "information-circle":
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="@Css">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="@Epaisseur"
                  d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        break;

    case "x":
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="@Css">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="@Epaisseur" d="M6 18L18 6M6 6l12 12" />
        </svg>
        break;

    case "download":
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="@Css">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="@Epaisseur"
                  d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
        </svg>
        break;

    case "printer":
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="@Css">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="@Epaisseur"
                  d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
        </svg>
        break;

    case "external-link":
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="@Css">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="@Epaisseur"
                  d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
        break;

    case "cog":
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="@Css">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="@Epaisseur"
                  d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="@Epaisseur"
                  d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        break;

    case "clipboard-list":
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="@Css">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="@Epaisseur"
                  d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
        </svg>
        break;

    default:
        @* Icône inconnue : point d'interrogation, plutôt qu'un trou silencieux dans l'interface. *@
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="@Css">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="@Epaisseur"
                  d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        break;
}

@code {
    /// <summary>Nom de l'icône (voir le switch ci-dessus).</summary>
    [Parameter] public string Nom { get; set; } = "";

    /// <summary>Classes CSS du SVG. Par défaut il remplit son conteneur.</summary>
    [Parameter] public string Css { get; set; } = "w-full h-full";

    /// <summary>Épaisseur du trait. 1.5 pour un rendu fin, 2 pour un rendu appuyé.</summary>
    [Parameter] public string Epaisseur { get; set; } = "2";
}


