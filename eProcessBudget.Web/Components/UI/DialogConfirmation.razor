@*
    Dialogue de confirmation générique, à utiliser avant toute action destructrice.

    APPEL DEPUIS UNE PAGE
    ---------------------
    @inject IDialogService DialogService

    var parametres = new DialogParameters<DialogConfirmation>
    {
        { x => x.Titre,    "Supprimer la commande" },
        { x => x.Message,  "Cette action est définitive. Confirmer la suppression ?" },
        { x => x.Libelle,  "Supprimer" },
        { x => x.Danger,   true }
    };

    var dialog  = await DialogService.ShowAsync<DialogConfirmation>("Confirmation", parametres);
    var reponse = await dialog.Result;
    if (reponse is { Canceled: false }) { ... }
*@

<MudDialog>
    <DialogContent>
        <div class="flex gap-4 py-1">
            <div class="flex-shrink-0 w-11 h-11 rounded-full flex items-center justify-center
                        @(Danger ? "bg-red-50" : "bg-amber-50")">
                <MudIcon Icon="@(Danger ? Icons.Material.Filled.DeleteForever : Icons.Material.Filled.HelpOutline)"
                         Style="@(Danger ? "color:#DC2626" : "color:#D97706")" />
            </div>

            <div class="flex-1 min-w-0">
                <p class="text-base font-semibold text-gray-800">@Titre</p>
                <p class="text-sm text-gray-600 mt-1">@Message</p>

                @if (ChildContent is not null)
                {
                    <div class="mt-3">@ChildContent</div>
                }
            </div>
        </div>
    </DialogContent>

    <DialogActions>
        <AppButton Variante="ghost" OnClick="Annuler">@LibelleAnnuler</AppButton>
        <AppButton Variante="@(Danger ? "danger" : "primary")" OnClick="Confirmer">@Libelle</AppButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = null!;

    [Parameter] public string Titre { get; set; } = "Confirmer l'action";
    [Parameter] public string Message { get; set; } = "Cette action est irréversible.";

    /// <summary>Libellé du bouton de confirmation.</summary>
    [Parameter] public string Libelle { get; set; } = "Confirmer";
    [Parameter] public string LibelleAnnuler { get; set; } = "Annuler";

    /// <summary>true pour une action destructrice : bouton rouge et icône de suppression.</summary>
    [Parameter] public bool Danger { get; set; }

    /// <summary>Détail additionnel (liste des éléments concernés, avertissement...).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private void Confirmer() => Dialog.Close(DialogResult.Ok(true));
    private void Annuler() => Dialog.Cancel();
}


