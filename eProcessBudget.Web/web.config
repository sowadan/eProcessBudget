<?xml version="1.0" encoding="utf-8"?>
<!--
  Configuration IIS (ANCM). dotnet publish complète processPath/arguments si besoin.

  DIAGNOSTIC — à désactiver une fois le problème résolu :

  stdoutLogEnabled="true" : la sortie console de l'application (dont l'exception qui
  fait échouer le démarrage, erreur 500.30) est écrite dans .\logs\stdout_*.log.
  Le compte du pool d'applications (IIS APPPOOL\eProcessBudget) doit pouvoir écrire
  dans ce dossier. Ces fichiers ne sont jamais purgés.

  ASPNETCORE_DETAILEDERRORS=true : lu par ANCM avant le démarrage de l'application,
  il affiche l'exception de démarrage dans la page 500.30 au lieu du message générique.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet"
                  arguments=".\eProcessBudget.Web.dll"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_DETAILEDERRORS" value="false" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>


