@* Taux et sa barre sur une ligne de tableau, couleurs de la Jauge : vert sous 80 %, orange jusqu'à 100 %, rouge au-delà. *@

<div class="flex items-center gap-2">
    <div class="h-1.5 flex-1 bg-gray-100 rounded-full overflow-hidden" role="presentation">
        <div class="h-full rounded-full @Fond" style="width:@Largeur"></div>
    </div>
    <span class="tabular-nums text-xs w-16 text-right @Couleur">@Formats.Taux(Taux)</span>
</div>

@code {
    [Parameter] public decimal? Taux { get; set; }

    private string Couleur => Taux switch { null => "text-gray-400", > 100 => "text-red-700 font-semibold", >= 80 => "text-amber-700", _ => "text-gray-900" };
    private string Fond => Taux switch { > 100 => "bg-red-500", >= 80 => "bg-amber-500", _ => "bg-emerald-500" };
    private string Largeur => FormattableString.Invariant($"{Math.Clamp(Taux ?? 0, 0, 100):0.##}%");
}
