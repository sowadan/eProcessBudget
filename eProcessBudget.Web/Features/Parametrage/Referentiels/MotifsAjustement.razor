@page "/parametrage/motifs-ajustement"

<PageTitle>Paramétrage</PageTitle>

@* Référentiel MotifAjustement : colonnes de la liste. Tout le reste (droits, filtres, saisie, Excel) vient de PageReferentiel. *@

<PageReferentiel T="MotifAjustement" Formulaire="typeof(FormulaireMotifAjustement)"
                 Description="Motifs des ajustements budgétaires, en hausse ou en baisse.">
    <EnTetes>
        <MudTh>Code</MudTh>
        <MudTh>Libellé</MudTh>
        <MudTh>Sens</MudTh>
    </EnTetes>
    <Colonnes>
        <MudTd DataLabel="Code"><span class="font-mono text-xs font-semibold text-gray-800">@context.Code</span></MudTd>
        <MudTd DataLabel="Libellé"><span class="text-sm text-gray-700">@context.Libelle</span></MudTd>
        <MudTd DataLabel="Sens"><span class="text-sm text-gray-500">@LibellesParametrage.De(LibellesParametrage.SensAjustement, context.Sens)</span></MudTd>
    </Colonnes>
</PageReferentiel>
