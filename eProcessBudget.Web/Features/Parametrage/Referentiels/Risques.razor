@page "/parametrage/risques"

<PageTitle>Paramétrage</PageTitle>

@* Référentiel Risque : colonnes de la liste. Tout le reste (droits, filtres, saisie, Excel) vient de PageReferentiel. *@

<PageReferentiel T="Risque" Formulaire="typeof(FormulaireRisque)"
                 Description="Risques rattachables aux objectifs du cadre logique.">
    <EnTetes>
        <MudTh>Code</MudTh>
        <MudTh>Libellé</MudTh>
        <MudTh>Catégorie</MudTh>
    </EnTetes>
    <Colonnes>
        <MudTd DataLabel="Code"><span class="font-mono text-xs font-semibold text-gray-800">@context.Code</span></MudTd>
        <MudTd DataLabel="Libellé"><span class="text-sm text-gray-700">@context.Libelle</span></MudTd>
        <MudTd DataLabel="Catégorie"><span class="text-sm text-gray-500">@(context.CategorieRisque?.Libelle ?? "—")</span></MudTd>
    </Colonnes>
</PageReferentiel>
