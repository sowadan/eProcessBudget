@page "/parametrage/axes"

<PageTitle>Paramétrage</PageTitle>

@* Référentiel Axe : colonnes de la liste. Tout le reste (droits, filtres, saisie, Excel) vient de PageReferentiel. *@

<PageReferentiel T="Axe" Formulaire="typeof(FormulaireAxe)"
                 Description="Les axes de dépense et de recette du budget, et leur section.">
    <EnTetes>
        <MudTh>Code</MudTh>
        <MudTh>Libellé</MudTh>
        <MudTh>Type</MudTh>
        <MudTh>Section</MudTh>
        <MudTh>Ordre</MudTh>
    </EnTetes>
    <Colonnes>
        <MudTd DataLabel="Code"><span class="font-mono text-xs font-semibold text-gray-800">@context.Code</span></MudTd>
        <MudTd DataLabel="Libellé"><span class="text-sm text-gray-700">@context.Libelle</span></MudTd>
        <MudTd DataLabel="Type"><span class="text-sm text-gray-500">@LibellesParametrage.De(LibellesParametrage.TypeAxe, context.TypeAxe)</span></MudTd>
        <MudTd DataLabel="Section"><span class="text-sm text-gray-500">@LibellesParametrage.De(LibellesParametrage.Section, context.Section)</span></MudTd>
        <MudTd DataLabel="Ordre"><span class="text-sm text-gray-500">@context.Ordre</span></MudTd>
    </Colonnes>
</PageReferentiel>
