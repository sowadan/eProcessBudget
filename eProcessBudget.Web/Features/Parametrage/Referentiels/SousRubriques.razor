@page "/parametrage/sous-rubriques"

<PageTitle>Paramétrage</PageTitle>

@* Référentiel SousRubrique : colonnes de la liste. Tout le reste (droits, filtres, saisie, Excel) vient de PageReferentiel. *@

<PageReferentiel T="SousRubrique" Formulaire="typeof(FormulaireSousRubrique)"
                 Description="Subdivisions des rubriques.">
    <EnTetes>
        <MudTh>Rubrique</MudTh>
        <MudTh>Code</MudTh>
        <MudTh>Libellé</MudTh>
    </EnTetes>
    <Colonnes>
        <MudTd DataLabel="Rubrique"><span class="text-sm text-gray-500">@context.Rubrique.Code</span></MudTd>
        <MudTd DataLabel="Code"><span class="font-mono text-xs font-semibold text-gray-800">@context.Code</span></MudTd>
        <MudTd DataLabel="Libellé"><span class="text-sm text-gray-700">@context.Libelle</span></MudTd>
    </Colonnes>
</PageReferentiel>
