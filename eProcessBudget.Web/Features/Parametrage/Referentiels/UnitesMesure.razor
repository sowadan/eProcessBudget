@page "/parametrage/unites-mesure"

<PageTitle>Paramétrage</PageTitle>

@* Référentiel UniteMesure : colonnes de la liste. Tout le reste (droits, filtres, saisie, Excel) vient de PageReferentiel. *@

<PageReferentiel T="UniteMesure" Formulaire="typeof(FormulaireUniteMesure)"
                 Description="Unités de mesure des indicateurs de performance.">
    <EnTetes>
        <MudTh>Code</MudTh>
        <MudTh>Libellé</MudTh>
        <MudTh>Type</MudTh>
        <MudTh>Symbole</MudTh>
    </EnTetes>
    <Colonnes>
        <MudTd DataLabel="Code"><span class="font-mono text-xs font-semibold text-gray-800">@context.Code</span></MudTd>
        <MudTd DataLabel="Libellé"><span class="text-sm text-gray-700">@context.Libelle</span></MudTd>
        <MudTd DataLabel="Type"><span class="text-sm text-gray-500">@LibellesParametrage.De(LibellesParametrage.TypeUnite, context.TypeUnite)</span></MudTd>
        <MudTd DataLabel="Symbole"><span class="text-sm text-gray-500">@context.Symbole</span></MudTd>
    </Colonnes>
</PageReferentiel>
