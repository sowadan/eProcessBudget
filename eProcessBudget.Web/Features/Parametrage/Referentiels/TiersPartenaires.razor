@page "/parametrage/tiers"

<PageTitle>Paramétrage</PageTitle>

@* Référentiel Tiers : colonnes de la liste. Tout le reste (droits, filtres, saisie, Excel) vient de PageReferentiel. *@

<PageReferentiel T="Tiers" Formulaire="typeof(FormulaireTiers)"
                 Description="Entités bénéficiaires, prestataires, partenaires financiers, organismes collecteurs, maîtres d'ouvrage.">
    <EnTetes>
        <MudTh>Code</MudTh>
        <MudTh>Raison sociale</MudTh>
        <MudTh>Type</MudTh>
        <MudTh>Catégorie</MudTh>
        <MudTh>Rattachement</MudTh>
    </EnTetes>
    <Colonnes>
        <MudTd DataLabel="Code"><span class="font-mono text-xs font-semibold text-gray-800">@context.Code</span></MudTd>
        <MudTd DataLabel="Raison sociale"><span class="text-sm text-gray-700">@context.RaisonSociale</span></MudTd>
        <MudTd DataLabel="Type"><span class="text-sm text-gray-500">@LibellesParametrage.De(LibellesParametrage.TypeTiers, context.TypeTiers)</span></MudTd>
        <MudTd DataLabel="Catégorie"><span class="text-sm text-gray-500">@(context.CategorieEntite?.Libelle ?? "—")</span></MudTd>
        <MudTd DataLabel="Rattachement"><span class="text-sm text-gray-500">@(context.TiersParent?.Code ?? "—")</span></MudTd>
    </Colonnes>
</PageReferentiel>
