@page "/parametrage/agents"

<PageTitle>Paramétrage</PageTitle>

@* Référentiel Agent : colonnes de la liste. Tout le reste (droits, filtres, saisie, Excel) vient de PageReferentiel. *@

<PageReferentiel T="Agent" Formulaire="typeof(FormulaireAgent)"
                 Description="Agents de l'organisme, pour la répartition du temps par action et activité.">
    <EnTetes>
        <MudTh>Matricule</MudTh>
        <MudTh>Nom</MudTh>
        <MudTh>Catégorie</MudTh>
        <MudTh>Structure</MudTh>
        <MudTh>Site</MudTh>
    </EnTetes>
    <Colonnes>
        <MudTd DataLabel="Matricule"><span class="font-mono text-xs font-semibold text-gray-800">@context.Matricule</span></MudTd>
        <MudTd DataLabel="Nom"><span class="text-sm text-gray-700">@context.NomComplet</span></MudTd>
        <MudTd DataLabel="Catégorie"><span class="text-sm text-gray-500">@context.CategorieEmploi.Code</span></MudTd>
        <MudTd DataLabel="Structure"><span class="text-sm text-gray-500">@context.Structure.Code</span></MudTd>
        <MudTd DataLabel="Site"><span class="text-sm text-gray-500">@(context.Site?.Code ?? "—")</span></MudTd>
    </Colonnes>
</PageReferentiel>
