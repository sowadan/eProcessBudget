@page "/parametrage/structures"

<PageTitle>Paramétrage</PageTitle>

@* Référentiel Structure : colonnes de la liste. Tout le reste (droits, filtres, saisie, Excel) vient de PageReferentiel. *@

<PageReferentiel T="Structure" Formulaire="typeof(FormulaireStructure)"
                 Description="Directions, services et cellules de l'organisme.">
    <EnTetes>
        <MudTh>Code</MudTh>
        <MudTh>Sigle</MudTh>
        <MudTh>Libellé</MudTh>
        <MudTh>Type</MudTh>
        <MudTh>Rattachement</MudTh>
        <MudTh>Responsable</MudTh>
    </EnTetes>
    <Colonnes>
        <MudTd DataLabel="Code"><span class="font-mono text-xs font-semibold text-gray-800">@context.Code</span></MudTd>
        <MudTd DataLabel="Sigle"><span class="text-sm text-gray-500">@context.Sigle</span></MudTd>
        <MudTd DataLabel="Libellé"><span class="text-sm text-gray-700">@context.Libelle</span></MudTd>
        <MudTd DataLabel="Type"><span class="text-sm text-gray-500">@(context.TypeStructure?.Libelle ?? "—")</span></MudTd>
        <MudTd DataLabel="Rattachement"><span class="text-sm text-gray-500">@(context.StructureParent?.Code ?? "—")</span></MudTd>
        <MudTd DataLabel="Responsable"><span class="text-sm text-gray-500">@context.ResponsableNom</span></MudTd>
    </Colonnes>
</PageReferentiel>
