@page "/parametrage/sources-financement"

<PageTitle>Paramétrage</PageTitle>

@* Référentiel SourceFinancement : colonnes de la liste. Tout le reste (droits, filtres, saisie, Excel) vient de PageReferentiel. *@

<PageReferentiel T="SourceFinancement" Formulaire="typeof(FormulaireSourceFinancement)"
                 Description="Ressources internes (RI) et externes (RE), avec leurs partenaires.">
    <EnTetes>
        <MudTh>Code</MudTh>
        <MudTh>Libellé</MudTh>
        <MudTh>Partenaire financier</MudTh>
    </EnTetes>
    <Colonnes>
        <MudTd DataLabel="Code"><span class="font-mono text-xs font-semibold text-gray-800">@context.Code</span></MudTd>
        <MudTd DataLabel="Libellé"><span class="text-sm text-gray-700">@context.Libelle</span></MudTd>
        <MudTd DataLabel="Partenaire financier"><span class="text-sm text-gray-500">@(context.PartenaireFinancier?.RaisonSociale ?? "—")</span></MudTd>
    </Colonnes>
</PageReferentiel>
