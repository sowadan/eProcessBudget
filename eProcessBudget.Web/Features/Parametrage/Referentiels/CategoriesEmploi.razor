@page "/parametrage/categories-emploi"

<PageTitle>Paramétrage</PageTitle>

@* Référentiel CategorieEmploi : colonnes de la liste. Tout le reste (droits, filtres, saisie, Excel) vient de PageReferentiel. *@

<PageReferentiel T="CategorieEmploi" Formulaire="typeof(FormulaireCategorieEmploi)"
                 Description="Catégories d'emplois utilisées dans la programmation des emplois.">
    <EnTetes>
        <MudTh>Code</MudTh>
        <MudTh>Libellé</MudTh>
        <MudTh>Ordre</MudTh>
    </EnTetes>
    <Colonnes>
        <MudTd DataLabel="Code"><span class="font-mono text-xs font-semibold text-gray-800">@context.Code</span></MudTd>
        <MudTd DataLabel="Libellé"><span class="text-sm text-gray-700">@context.Libelle</span></MudTd>
        <MudTd DataLabel="Ordre"><span class="text-sm text-gray-500">@context.Ordre</span></MudTd>
    </Colonnes>
</PageReferentiel>
