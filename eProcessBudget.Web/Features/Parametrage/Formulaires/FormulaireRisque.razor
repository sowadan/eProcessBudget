@inherits FormulaireBase<Risque>
@inject IReferentielService<ListeValeur> ServiceListeValeur

@* Formulaire de saisie : Risque. Généré à l'identique pour tous les référentiels ; les règles sont dans CatalogueReferentiels. *@

<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <MudTextField @bind-Value="Element.Code" Label="Code" MaxLength="20" Required="true" RequiredError="Code : obligatoire."
                  Variant="Variant.Outlined" Margin="Margin.Dense" />
    <MudTextField @bind-Value="Element.Libelle" Label="Libellé" MaxLength="300" Required="true" RequiredError="Libellé : obligatoire." Lines="2"
                  Variant="Variant.Outlined" Margin="Margin.Dense" Class="sm:col-span-2" />
    <div class="sm:col-span-2"><ChoixReference Label="Catégorie" Elements="_categories"
                    Value="Element.CategorieRisqueId" ValueChanged="v => Element.CategorieRisqueId = v" /></div>
</div>

@code {
    private List<ElementListe> _categories = new();

    protected override async Task OnInitializedAsync()
    {
        _categories = await ServiceListeValeur.ListerPourSelectionAsync(l => l.Categorie == CategoriesListeValeur.CategorieRisque);
    }
}
