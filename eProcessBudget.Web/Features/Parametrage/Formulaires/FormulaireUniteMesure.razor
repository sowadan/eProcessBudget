@inherits FormulaireBase<UniteMesure>

@* Formulaire de saisie : UniteMesure. Généré à l'identique pour tous les référentiels ; les règles sont dans CatalogueReferentiels. *@

<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <MudTextField @bind-Value="Element.Code" Label="Code" MaxLength="20" Required="true" RequiredError="Code : obligatoire."
                  Variant="Variant.Outlined" Margin="Margin.Dense" />
    <MudTextField @bind-Value="Element.Libelle" Label="Libellé" MaxLength="100" Required="true" RequiredError="Libellé : obligatoire."
                  Variant="Variant.Outlined" Margin="Margin.Dense" />
    <ChoixEnum TEnum="TypeUnite" Label="Type" Libelles="LibellesParametrage.TypeUnite" @bind-Value="Element.TypeUnite" />
    <MudTextField @bind-Value="Element.Symbole" Label="Symbole" MaxLength="10"
                  Variant="Variant.Outlined" Margin="Margin.Dense" />
</div>
