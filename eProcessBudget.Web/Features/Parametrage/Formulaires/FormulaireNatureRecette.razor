@inherits FormulaireBase<NatureRecette>
@inject IReferentielService<CompteComptable> ServiceCompteComptable
@inject IReferentielService<NatureRecette> ServiceNatureRecette

@* Formulaire de saisie : NatureRecette. Généré à l'identique pour tous les référentiels ; les règles sont dans CatalogueReferentiels. *@

<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <MudTextField @bind-Value="Element.Code" Label="Code" MaxLength="20" Required="true" RequiredError="Code : obligatoire."
                  Variant="Variant.Outlined" Margin="Margin.Dense" />
    <ChoixEnum TEnum="CategorieRecette" Label="Catégorie" Libelles="LibellesParametrage.CategorieRecette" @bind-Value="Element.CategorieRecette" />
    <MudTextField @bind-Value="Element.Libelle" Label="Libellé" MaxLength="200" Required="true" RequiredError="Libellé : obligatoire."
                  Variant="Variant.Outlined" Margin="Margin.Dense" Class="sm:col-span-2" />
    <div><ChoixReference Label="Nature de regroupement" Elements="_natures"
                    Value="Element.NatureParentId" ValueChanged="v => Element.NatureParentId = v" /></div>
    <div><ChoixReference Label="Compte de produit" Elements="_comptes"
                    Value="Element.CompteComptableId" ValueChanged="v => Element.CompteComptableId = v" /></div>
    <MudSwitch T="bool" @bind-Value="Element.SuiviParSite" Label="Saisie par site (péage, pesage)" Color="Color.Primary" Class="sm:col-span-2" />
</div>

@code {
    private List<ElementListe> _natures = new();
    private List<ElementListe> _comptes = new();

    protected override async Task OnInitializedAsync()
    {
        _natures = await ServiceNatureRecette.ListerPourSelectionAsync();
        _comptes = await ServiceCompteComptable.ListerPourSelectionAsync();
        _natures.RemoveAll(e => e.Id == Element.Id);
    }
}
