@page "/budget-programme/programmes"

<PageTitle>Budget-programme</PageTitle>

<PageReferentiel T="Programme" Formulaire="typeof(FormulaireProgramme)" Rubrique="Budget-programme" LienRubrique="/budget-programme"
                 Description="Programmes du budget-programme : objectif général, responsable, présentation.">
    <EnTetes>
        <MudTh>Code</MudTh>
        <MudTh>Libellé</MudTh>
        <MudTh>Objectif général</MudTh>
        <MudTh>Ordre</MudTh>
    </EnTetes>
    <Colonnes>
        <MudTd DataLabel="Code"><span class="font-mono text-xs font-semibold text-gray-800">@context.Code</span></MudTd>
        <MudTd DataLabel="Libellé"><span class="text-sm text-gray-700">@context.Libelle</span></MudTd>
        <MudTd DataLabel="Objectif général"><span class="text-sm text-gray-500">@context.ObjectifGeneral</span></MudTd>
        <MudTd DataLabel="Ordre"><span class="text-sm text-gray-500">@context.Ordre</span></MudTd>
    </Colonnes>
</PageReferentiel>
