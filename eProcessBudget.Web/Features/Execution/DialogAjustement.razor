@inject IAjustementService Service
@inject IReferentielService<MotifAjustement> ServiceMotif

@* Ajustement d'une dotation : hausse ou baisse, motif et justification obligatoires. La saisie vaut soumission. *@

<MudDialog>
    <DialogContent>
        @if (_erreur is not null)
        {
            <div class="mb-3"><AppAlert Variante="danger" Titre="Enregistrement impossible">@_erreur</AppAlert></div>
        }
        <div class="space-y-4">
            <ChoixDotation ExerciceId="ExerciceId" Value="Saisie.DotationId" ValueChanged="v => Saisie.DotationId = v" LibelleInitial="LibelleDotation" />
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <MudRadioGroup T="bool" @bind-Value="_hausse">
                    <MudRadio T="bool" Value="true" Color="Color.Success">Hausse</MudRadio>
                    <MudRadio T="bool" Value="false" Color="Color.Error">Baisse</MudRadio>
                </MudRadioGroup>
                <MudNumericField T="decimal" @bind-Value="_montant" Label="Montant" Min="0" Format="N2" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudDatePicker Date="Date" DateChanged="d => Saisie.Date = d is { } v ? DateOnly.FromDateTime(v) : null" Label="Date"
                               DateFormat="dd/MM/yyyy" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <ChoixReference Label="Motif" Elements="_motifs" Obligatoire="true" Value="Saisie.MotifId" ValueChanged="v => Saisie.MotifId = v" />
            </div>
            <MudTextField @bind-Value="Saisie.Justification" Label="Justification" Lines="3" MaxLength="1000" Counter="1000"
                          Variant="Variant.Outlined" Margin="Margin.Dense" />
        </div>
    </DialogContent>
    <DialogActions>
        <AppButton Variante="ghost" OnClick="() => Dialog.Cancel()">Annuler</AppButton>
        <AppButton Icone="check-circle" EnChargement="_enregistrement" OnClick="EnregistrerAsync">Soumettre</AppButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = null!;
    [Parameter] public SaisieAjustement Saisie { get; set; } = new();
    [Parameter] public Ulid ExerciceId { get; set; }
    [Parameter] public string? LibelleDotation { get; set; }

    private List<ElementListe> _motifs = new();
    private bool _hausse = true;
    private decimal _montant;
    private bool _enregistrement;
    private string? _erreur;

    private DateTime? Date => Saisie.Date?.ToDateTime(TimeOnly.MinValue);

    protected override async Task OnInitializedAsync()
    {
        _motifs = await ServiceMotif.ListerPourSelectionAsync();
        _hausse = Saisie.Montant >= 0;
        _montant = Math.Abs(Saisie.Montant);
    }

    private async Task EnregistrerAsync()
    {
        Saisie.Montant = _hausse ? _montant : -_montant;
        _enregistrement = true;
        (var ok, _erreur) = await Service.EnregistrerAsync(Saisie);
        _enregistrement = false;
        if (ok) Dialog.Close(DialogResult.Ok(true));
    }
}
