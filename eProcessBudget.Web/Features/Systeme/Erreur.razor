@page "/erreur"
@layout EmptyLayout
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Diagnostics
@using Microsoft.Extensions.Options
@inject IOptions<ApplicationOptions> AppOptions
@inject IHostEnvironment Environnement

<PageTitle>Erreur — @AppOptions.Value.Nom</PageTitle>

@*
    Page d'erreur générique, branchée dans Program.cs via UseExceptionHandler.

    En production on n'affiche JAMAIS le détail technique : il renseignerait un attaquant
    sur la structure interne. L'identifiant de requête permet en revanche à l'exploitant
    de retrouver la trace complète dans les journaux.
*@

<div class="min-h-screen flex items-center justify-center p-4"
     style="background: linear-gradient(135deg, var(--app-secondaire) 0%, var(--app-tertiaire) 100%);">

    <div class="w-full max-w-lg">
        <div class="bg-white rounded-2xl shadow-2xl p-8 text-center">
            <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Large"
                     Style="color: var(--app-primaire);" Class="mb-3" />

            <h1 class="text-xl font-bold text-gray-800 mb-2">Une erreur est survenue</h1>
            <p class="text-sm text-gray-600 mb-6">
                L'opération n'a pas pu aboutir. Réessayez dans un instant ;
                si le problème persiste, signalez-le au support.
            </p>

            @if (!string.IsNullOrEmpty(_identifiantRequete))
            {
                <p class="text-xs text-gray-400 mb-6">
                    Référence à communiquer au support :
                    <code class="font-mono text-gray-600">@_identifiantRequete</code>
                </p>
            }

            @if (Environnement.IsDevelopment() && _detail is not null)
            {
                <div class="text-left bg-gray-50 border border-gray-200 rounded-lg p-4 mb-6 zone-defilante">
                    <p class="text-xs font-semibold text-gray-700 mb-1">
                        Détail (visible en développement uniquement)
                    </p>
                    <pre class="text-[11px] text-gray-600 whitespace-pre-wrap">@_detail</pre>
                </div>
            }

            <a href="/" class="inline-block w-full py-2.5 text-white font-semibold rounded-lg text-sm"
               style="background-color: var(--app-primaire);">
                Retour à l'accueil
            </a>
        </div>
    </div>
</div>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private string? _identifiantRequete;
    private string? _detail;

    protected override void OnInitialized()
    {
        _identifiantRequete = System.Diagnostics.Activity.Current?.Id ?? HttpContext?.TraceIdentifier;

        if (Environnement.IsDevelopment())
        {
            var feature = HttpContext?.Features.Get<IExceptionHandlerPathFeature>();
            _detail = feature?.Error.ToString();
        }
    }
}


